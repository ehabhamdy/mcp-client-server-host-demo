{
    "mcpServers": {
        "puppeteer": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-puppeteer"
            ]
        },
        "postgres": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "mcp/postgres",
                "postgresql://host.docker.internal:5432/mydb"
            ]
        },
        "math": {
            "command": "python",
            "args": [
                "math_mcp.py"
            ]
        }
    }
}